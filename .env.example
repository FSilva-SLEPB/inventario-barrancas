# Identificadores de ejemplo. Consultar con id -u e id -g.
LOCAL_UID=1000
LOCAL_GID=1000

# Contraseñas locales. Generar con bash scripts/preparar-entorno.sh.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# OAuth propio de la web, separado de Drive. No pegar valores en Git ni en chat.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: envío de actas desde una cuenta institucional de no responder.
# Configurar en CentOS; nunca introducir credenciales en Git ni en el chat.
ACTAS_CORREO_REMITENTE=
ACTAS_SMTP_HOST=
ACTAS_SMTP_PUERTO=587
# si = TLS directo; no = STARTTLS obligatorio. Siempre se verifica el certificado.
ACTAS_SMTP_TLS_DIRECTO=no
ACTAS_SMTP_USUARIO=
ACTAS_SMTP_CLAVE=
