# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS dependencias
ENV NEXT_TELEMETRY_DISABLED=1 npm_config_cache=/tmp/npm-cache
WORKDIR /app
COPY web/package.json web/package-lock.json ./
# La CA adicional se usa solo durante esta instalación cuando el entorno la necesita.
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci

FROM dependencias AS compilacion
COPY web/ ./
RUN npm run build

FROM node:24-bookworm-slim AS ejecucion
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
ARG APP_REVISION=local
LABEL org.opencontainers.image.title="Inventario Barrancas" \
      org.opencontainers.image.revision=$APP_REVISION
COPY --from=compilacion --chown=node:node /app/.next/standalone ./
COPY --from=compilacion --chown=node:node /app/.next/static ./.next/static
COPY --from=compilacion --chown=node:node /app/public ./public
RUN mkdir -p /app/.next/cache && chown node:node /app/.next/cache
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
 CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/salud',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
