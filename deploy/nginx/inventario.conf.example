# Ejemplo para http{} / conf.d de nginx. Reemplazar dominio y rutas de certificados.
# La aplicación permanece en 127.0.0.1:3000; este proxy termina HTTPS.
limit_req_zone $binary_remote_addr zone=inventario_salud:1m rate=1r/s;

server {
    listen 80;
    server_name inventario.ejemplo.cl;
    if ($host != inventario.ejemplo.cl) { return 444; }
    return 308 https://inventario.ejemplo.cl$request_uri;
}
server {
    listen 443 ssl;
    server_name inventario.ejemplo.cl;
    if ($host != inventario.ejemplo.cl) { return 444; }
    ssl_certificate /etc/ssl/inventario/fullchain.pem;
    ssl_certificate_key /etc/ssl/inventario/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 3m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    location = /api/salud {
        limit_req zone=inventario_salud burst=2 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
